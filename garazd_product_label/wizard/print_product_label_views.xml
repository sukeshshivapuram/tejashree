<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="print_product_label_view_form" model="ir.ui.view">
        <field name="name">print.product.label.view.form</field>
        <field name="model">print.product.label</field>
        <field name="arch" type="xml">
            <form create="false" string="Print Product Labels">
                <header class="bg-white">
                    <button name="action_print_direct" string="Print" help="Print product labels" type="object" icon="fa-print" class="btn-primary mr8"/>
                    <button name="action_print"
                            string="Download / Direct Print"
                            help="Download product labels or print them directly via IoT Box or third-party apps"
                            type="object"
                            icon="fa-download"
                            class="btn-light border mr8"
                    />
                    <field name="label_type_id" widget="selection_badge" invisible="1"/>  <!-- Technical field to specify the label type -->
                </header>
                <div class="oe_button_box" name="button_box"/>

                <div class="alert alert-info text-center mb-3" invisible="not message" role="alert">
                    <field name="message"/>
                </div>
                <group col="4" colspan="2" name="top_group" class="mt16">
                    <group name="output_format" col="2" colspan="2" invisible="1">
                        <!-- This section is hidden as the solution generates labels in the PDF only now. -->
                        <field name="output" widget="badge" invisible="1"/> <!-- Temporary hide the field -->
                    </group>
                    <group name="label_report" col="2" colspan="2">
                        <field name="report_id" string="Label" widget="radio"/>
                    </group>
                    <group name="label_template" col="2" colspan="2" invisible="not is_template_report">
                        <label for="report_id" string="Template"/>
                        <div class="o_row" name="label_builder_link">
                            <a invisible="not is_template_report" href="https://garazd.biz/r/cng" title="How to get Product Label Builder" target="_blank" rel="noopener noreferrer">
                                <span>Get the Label Builder to create your own labels</span>
                            </a>
                        </div>
                    </group>
                </group>
                <notebook>
                    <page string="Labels" name="labels">
                        <field name="label_ids" mode="list">
                            <list editable="top" decoration-muted="qty==0">
                                <field name="sequence" widget="handle" width="0.5"/>
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="partner_id" optional="hide"/>
                                <field name="product_id"/>
                                <field name="barcode" optional="show"/>
                                <field name="custom_value" optional="hide"/>
                                <field name="total_number" optional="hide"/>
                                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                                <field name="qty" sum="Total" width="0.6" class="text-center font-weight-bold"/>
                            </list>
                        </field>
                    </page>
                    <page string="Options" name="options">
                        <group name="general_options" class="o_label_nowrap">
                            <group string="General" name="general_settings">
                                <field name="company_id" widget="selection" groups="base.group_multi_company"/>
                                <field name="lang" widget="radio" options="{'horizontal': true}"/>
                            </group>
                            <group string="Design" name="print_settings" invisible="is_template_report">
                                <field name="humanreadable" widget="boolean_toggle" />
                                <field name="border_width" />
                                <field name="cols" />
                                <field name="rows" />
                            </group>
                        </group>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="action_print_label_from_template" model="ir.actions.act_window">
        <field name="name">Custom Product Labels</field>
        <field name="res_model">print.product.label</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_product_template_ids': active_ids}</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
    </record>

    <record id="action_print_label_from_product" model="ir.actions.act_window">
        <field name="name">Custom Product Labels</field>
        <field name="res_model">print.product.label</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_product_product_ids': active_ids}</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">action</field>
    </record>

    <record id="action_print_label_pricelist" model="ir.actions.act_window">
        <field name="name">Custom Product Labels</field>
        <field name="res_model">print.product.label</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_pricelist_id': active_id}</field>
        <field name="binding_model_id" ref="product.model_product_pricelist"/>
        <field name="binding_view_types">form</field>
        <field name="binding_type">action</field>
    </record>

</odoo>
