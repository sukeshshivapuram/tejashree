<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="label_57x35">
        <table class="table" style="margin: 0; padding: 0;">
            <tbody style="border: 0;">
                <tr height="144px" style="border:0;margin:0;padding:0;">
                    <td class="col-xs-4 text-center" style="border:0;margin:0;padding:0;">
                        <div style="overflow:hidden; height:65px !important; padding: 5px 5px 0; line-height: 1.2;">
                             <span t-field="label.product_id.name" style="line-height: 1.2;"/>
                             <span t-if="label.product_id.product_template_attribute_value_ids"
                                   t-esc="u', '.join(map(lambda x: x.attribute_line_id.attribute_id.name + u': ' + x.name, label.product_id.product_template_attribute_value_ids))"
                                   class="badge"/>
                        </div>
                        <div style="width: 100%; padding: 0; margin: 0; font-size: 21px; font-weight: bold;">
                            <span t-if="label.product_id.currency_id.position == 'before'" t-field="label.product_id.currency_id.symbol"/>
                            <span t-field="label.product_id.lst_price"/>
                            <span t-if="label.product_id.currency_id.position == 'after'" t-field="label.product_id.currency_id.symbol"/>
                        </div>
                        <div t-if="label.product_id.default_code" style="width: 100%; padding: 0; margin: 0; font-size: 12px;">
                            <span t-field="label.product_id.default_code"/>
                        </div>
                        <t t-if="label.product_id.barcode">
                            <div t-out="label.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'overflow: hidden; width: 100%; height: 1.4rem;', 'humanreadable': label.wizard_id.humanreadable}" class="px-1"/>
                        </t>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_product_label_57x35_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="count" t-value="0" />
                <div class="page">
                    <div class="oe_structure"/>
                    <t t-foreach="docs" t-as="label">
                        <t t-set="qty" t-value="1" />
                        <t t-if="label.qty">
                            <t t-set="qty" t-value="label.qty" />
                        </t>
                        <t t-foreach="list(range(qty))" t-as="index_qty">
                            <div t-if="count % 21 == 0" style="page-break-after:always;"/>
                            <div t-if="count % 3 == 0" style="clear:both;"/>
                            <div t-att-style="'width: 233px; float: left; height: 145px; margin: 0 4px 4px; border: {};'.format('%dpx solid #777;' % label.wizard_id.border_width if label.wizard_id.border_width else '0')">
                                <t t-call="garazd_product_label.label_57x35"/>
                            </div>
                            <t t-set="count" t-value="count+1" />
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <template id="report_product_label_50x38_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="label">
                    <t t-set="qty" t-value="1"/>
                    <t t-if="label.qty" t-set="qty" t-value="label.qty" />
                    <t t-foreach="list(range(qty))" t-as="index_qty">
                        <div class="page" style="page-break-after: always;">
                            <div style="height: 136px !important; width: 165px !important;">
                                <table class="table" t-att-style="'height: 100%; border: {};'.format('%dpx solid #777;' % label.wizard_id.border_width if label.wizard_id.border_width else '0')">
                                    <tbody style="border: 0;">
                                        <tr style="border: 0;">
                                            <td class="text-center" style="padding: 0; margin: 0; border: 0;">
                                                <div style="overflow: hidden; height: 64px !important; font-size: 13px; line-height: 1.2; margin-bottom: 2px;">
                                                    <span t-field="label.product_id.name" style="line-height: 1.2;"/>
                                                    <span t-if="label.product_id.product_template_attribute_value_ids"
                                                          t-esc="u', '.join(map(lambda x: x.attribute_line_id.attribute_id.name + u': ' + x.name, label.product_id.product_template_attribute_value_ids))"
                                                          class="badge"/>
                                                </div>
                                                <div style="width: 100%; overflow: hidden; height: 26px !important;">
                                                    <div style="float: right; width: 60%; font-size: 20px; font-weight: bold; line-height: 1.0; text-align: right; margin-bottom: 0px;">
                                                        <span t-if="label.product_id.currency_id.position == 'before'" t-field="label.product_id.currency_id.symbol"/>
                                                        <span t-field="label.product_id.lst_price"/>
                                                        <span t-if="label.product_id.currency_id.position == 'after'" t-field="label.product_id.currency_id.symbol"/>
                                                    </div>
                                                    <div style="float: left; width: 40%; font-size: 10px; font-weight: 900; line-height: 1.0; text-align: left; margin-bottom: 0px; padding-top: 6px;">
                                                        <span t-if="label.product_id.default_code"><span t-field="label.product_id.default_code"/> </span>
                                                    </div>
                                                </div>
                                                <t t-if="label.product_id.barcode">
                                                    <div t-out="label.product_id.barcode" style="margin-top: 5px;" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'overflow: hidden; width: 100%; height: 2.0rem;', 'humanreadable': label.wizard_id.humanreadable}"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_product_label_66x25_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="label">
                    <t t-set="qty" t-value="1"/>
                    <t t-if="label.qty" t-set="qty" t-value="label.qty" />
                    <t t-foreach="list(range(qty))" t-as="index_qty">
                        <div class="page" style="page-break-after: always;">
                            <div style="height: 89px !important; width: 218px !important;">
                                <table class="table" t-att-style="'height: 100%; border: {};'.format('%dpx solid #777;' % label.wizard_id.border_width if label.wizard_id.border_width else '0')">
                                    <tbody style="border: 0;">
                                        <tr height="89px" style="border: 0;">
                                            <td class="text-center" style="padding: 0; margin: 0; border: 0;">
                                                <div style="overflow: hidden; height: 45px !important; font-size: 13px; line-height: 1.175; margin-bottom: 3px; text-align: left;">
                                                    <span t-field="label.product_id.name" style="line-height: 1.175;"/>
                                                    <span t-if="label.product_id.product_template_attribute_value_ids"
                                                          t-out="u', '.join(map(lambda x: x.attribute_line_id.attribute_id.name + u': ' + x.name, label.product_id.product_template_attribute_value_ids))"
                                                          class="badge"/>
                                                </div>
                                                <div style="width: 100%; overflow: hidden; height: 40px !important;">
                                                    <div style="float: left; width: 60%; font-size: 20px; font-weight: bold; line-height: 1.0; text-align: right; margin-bottom: 0px;">
                                                        <t t-if="label.product_id.barcode" style="height: 16px !important; margin: 2px 0;">
                                                            <div t-out="label.product_id.barcode" style="margin-left: 2px;" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'overflow: hidden; width: 100%; height: 1.5rem;', 'humanreadable': label.wizard_id.humanreadable}"/>
                                                            <div t-if="not label.wizard_id.humanreadable" t-field="label.product_id.barcode" style="font-size: 10px; font-weight: normal; text-align: left; margin-left: 2px; margin-top: 2px;"/>
                                                        </t>
                                                    </div>
                                                    <div style="float: right; width: 40%;">
                                                        <div style="width: 100%; font-size: 16px; font-weight: 900; line-height: 1.0; text-align: right; margin-bottom: 2px;">
                                                            <span t-if="label.product_id.currency_id.position == 'before'" t-field="label.product_id.currency_id.symbol"/>
                                                            <span t-field="label.product_id.lst_price"/>
                                                            <span t-if="label.product_id.currency_id.position == 'after'" t-field="label.product_id.currency_id.symbol"/>
                                                        </div>
                                                        <div t-if="label.product_id.default_code" style="width: 100%; font-size: 9px; font-weight: 900; line-height: 1.0; text-align: center; background: #000; color: #FFF; margin-left: 3px;">
                                                            <span t-field="label.product_id.default_code"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="label_50x25">
        <div style="width: 100%; height: 100%; padding: 1.5mm 2.5mm; box-sizing: border-box; overflow: hidden; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
            <!-- Header Row: Product Name & Price -->
            <div style="width: 100%; overflow: hidden; height: 16px; margin-bottom: 2px;">
                <div style="float: left; width: 62%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; font-weight: bold; color: #111111; line-height: 1.2; text-align: left;">
                    <span t-field="label.product_id.name"/>
                </div>
                <div style="float: right; width: 38%; font-size: 13px; font-weight: 900; color: #000000; text-align: right; line-height: 1.1;">
                    <span t-if="label.product_id.currency_id.position == 'before'" t-field="label.product_id.currency_id.symbol"/>
                    <span t-field="label.product_id.lst_price"/>
                    <span t-if="label.product_id.currency_id.position == 'after'" t-field="label.product_id.currency_id.symbol"/>
                </div>
            </div>

            <!-- Sub-info: Attributes & Internal Ref Code -->
            <div style="width: 100%; overflow: hidden; height: 13px; margin-bottom: 2px;">
                <div style="float: left; width: 60%; font-size: 8.5px; color: #555555; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                    <t t-if="label.product_id.product_template_attribute_value_ids">
                        <span t-out="u', '.join(map(lambda x: x.name, label.product_id.product_template_attribute_value_ids))"/>
                    </t>
                    <t t-elif="label.company_id">
                        <span t-field="label.company_id.name"/>
                    </t>
                </div>
                <div t-if="label.product_id.default_code" style="float: right; width: 40%; font-size: 8px; font-weight: 700; color: #222222; text-align: right;">
                    <span style="background: #eef1f5; border-radius: 2px; padding: 1px 3px;" t-field="label.product_id.default_code"/>
                </div>
            </div>

            <!-- Hairline Divider -->
            <div style="width: 100%; border-top: 1px dashed #cccccc; margin: 1px 0 2px 0;"/>

            <!-- Barcode Section -->
            <div style="width: 100%; text-align: center; overflow: hidden;">
                <t t-if="label.product_id.barcode">
                    <div t-out="label.product_id.barcode" style="margin: 0 auto; width: 100%;" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': 'overflow: hidden; width: 100%; height: 1.1rem;'}"/>
                    <div style="font-size: 8.5px; font-weight: bold; font-family: 'Courier New', Courier, monospace; letter-spacing: 1px; text-align: center; margin-top: 1px; color: #000000; line-height: 1.0;">
                        <span t-field="label.product_id.barcode"/>
                    </div>
                </t>
                <t t-else="">
                    <div style="font-size: 9px; color: #999999; font-style: italic; padding-top: 2px;">No Barcode</div>
                </t>
            </div>
        </div>
    </template>

    <template id="report_product_label_50x25_2col_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style type="text/css">
                    body, html {
                        margin: 0 !important;
                        padding: 0 !important;
                    }
                    .o_label_container {
                        width: 100%;
                        margin: 0 !important;
                        padding: 0 !important;
                    }
                    .o_label_cell {
                        margin: 0 !important;
                        padding: 1mm 2mm !important;
                        box-sizing: border-box;
                        float: left;
                        overflow: hidden;
                    }
                </style>
                <t t-set="count" t-value="0" />
                <div class="page o_label_container">
                    <t t-foreach="docs" t-as="label">
                        <t t-set="qty" t-value="1" />
                        <t t-if="label.qty" t-set="qty" t-value="label.qty" />
                        <t t-set="cols" t-value="label.wizard_id.cols or 2" />
                        <t t-set="rows" t-value="label.wizard_id.rows or 1" />
                        <t t-set="page_size" t-value="cols * rows" />
                        <t t-set="col_width_pct" t-value="100.0 / cols" />

                        <t t-foreach="list(range(qty))" t-as="index_qty">
                            <t t-if="count &gt; 0 and count % page_size == 0">
                                <div style="page-break-after: always; clear: both;"/>
                            </t>
                            <t t-elif="count &gt; 0 and count % cols == 0">
                                <div style="clear: both;"/>
                            </t>
                            <div class="o_label_cell"
                                 t-att-style="'width: {}%; height: 25mm; border: {};'.format(col_width_pct, '%dpx solid #777;' % label.wizard_id.border_width if label.wizard_id.border_width else '0')">
                                <t t-call="garazd_product_label.label_50x25"/>
                            </div>
                            <t t-set="count" t-value="count + 1" />
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <template id="report_product_label_from_template">
        <t t-call="web.basic_layout"/>
    </template>

</odoo>
