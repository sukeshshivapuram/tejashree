<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_garazd_label" model="ir.ui.view">
        <field name="name">product.template.form.garazd.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="mb-2">
                    <button name="action_open_custom_label_wizard" string="Print Labels" type="object" class="btn btn-primary" icon="fa-print"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view_inherit_garazd_label" model="ir.ui.view">
        <field name="name">product.product.form.garazd.label</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="mb-2">
                    <button name="action_open_custom_label_wizard" string="Print Labels" type="object" class="btn btn-primary" icon="fa-print"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
